; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PixelWorld Demo"
run/main_scene="res://demo/demo_main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/pixel_world/plugin.cfg")

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2

[shader_globals]

pw_snow_amount={
"type": "float",
"value": 0.0
}
pw_wetness={
"type": "float",
"value": 0.0
}
pw_night_factor={
"type": "float",
"value": 0.0
}
pw_wind={
"type": "vec2",
"value": Vector2(0.3, 0)
}
pw_flash={
"type": "float",
"value": 0.0
}
pw_desaturate={
"type": "float",
"value": 0.0
}
pw_light_color={
"type": "color",
"value": Color(1, 1, 1, 1)
}
pw_rain={
"type": "float",
"value": 0.0
}
pw_sky_color={
"type": "color",
"value": Color(0.74, 0.83, 0.93, 1)
}
pw_step0={
"type": "vec4",
"value": Vector4(0, 0, 99, 0)
}
pw_step1={
"type": "vec4",
"value": Vector4(0, 0, 99, 0)
}
pw_step2={
"type": "vec4",
"value": Vector4(0, 0, 99, 0)
}
pw_step3={
"type": "vec4",
"value": Vector4(0, 0, 99, 0)
}
